# App: role app_user (sem BYPASSRLS), conexão pooled. Gerada por `npm run db:criar-role-app`.
DATABASE_URL=
# Migrações (drizzle-kit): role dona das tabelas, conexão direta.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Edição: pessoal (cadastro fechado, sem demo) | portfolio (cadastro aberto, demo). Inlined no build; ausente/inválido = pessoal.
NEXT_PUBLIC_EDICAO=pessoal
CRON_SECRET=

# Arquivos locais (gitignored por .env*.local), todos com estas mesmas chaves:
#   .env.local             -> branch dev do Neon (scripts/criar-env-local.ps1)
#   .env.production.local  -> branch production do Neon, só para migrações/scripts administrativos
#                             e para copiar valores à Vercel (scripts/criar-env-producao.ps1).
#                             Guia: docs/publicar-edicao-pessoal.md
# Na Vercel, DATABASE_URL é SEMPRE a do app_user (pooled), nunca a do owner (DATABASE_URL_UNPOOLED).
